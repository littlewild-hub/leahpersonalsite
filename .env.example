# ---------------------------------------------------------------------------
# Content source
# "local"    -> reads /content (default, no credentials needed)
# "airtable" -> reads from Airtable via the REST API
# ---------------------------------------------------------------------------
CONTENT_SOURCE=local

# --- Airtable (only needed when CONTENT_SOURCE=airtable) --------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_DISCIPLINES_TABLE=Disciplines
AIRTABLE_INQUIRIES_TABLE=Inquiries
AIRTABLE_PROFILE_TABLE=Profile

# --- On-demand revalidation -------------------------------------------------
# POST to /api/revalidate with header  x-revalidate-secret: <this value>
REVALIDATE_SECRET=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000
